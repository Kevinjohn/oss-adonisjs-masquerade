{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "index.ts",
    "src/types.ts",
    "auth/main.ts",
    "http/main.ts",
    "native/main.ts",
    "stores/lucid.ts",
    "providers/masquerade_provider.ts",
    "commands/main.ts",
    "testing/main.ts",
    "plugins/api_client.ts"
  ],
  "out": "docs/api",
  "plugin": ["typedoc-plugin-markdown"],
  "entryFileName": "index",
  "readme": "none",
  "excludePrivate": true,
  "excludeInternal": true,
  "hidePageHeader": true,
  "githubPages": false,
  "gitRevision": "main",
  "treatWarningsAsErrors": true,
  "validation": { "notDocumented": true },
  "requiredToBeDocumented": ["Class", "Function", "Interface", "TypeAlias", "Variable"],
  "intentionallyNotExported": [
    "errorDetails",
    "default",
    "RequestAdmission",
    "EffectiveSessionGuard",
    "EffectiveAccessTokensGuard",
    "SharedAuthorityOptions",
    "StandaloneAuthorityOptions",
    "RouteGuardSelection",
    "MarkedMiddleware"
  ],
  "externalSymbolLinkMappings": {
    "@adonisjs/ace": {
      "CommandMetaData": "https://github.com/adonisjs/ace"
    }
  }
}
