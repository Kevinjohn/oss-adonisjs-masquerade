@layouts.app({ title: 'Support workspace' })
  @page({
    title: 'Support workspace',
    description: 'A small, local example of account-wide customer support mode.',
  })
    <div class="support-stack">
      @if(masqueradeFlash?.type === 'success')
        <p role="status" class="support-copy">
          {{ masqueradeFlash.action === 'started' ? 'Support mode started.' : 'Support mode stopped.' }}
        </p>
      @elseif(masqueradeFlash?.type === 'error')
        <p role="alert" class="support-copy">
          Support mode could not be changed ({{ masqueradeFlash.code }}). Check and try again.
        </p>
      @end
      <section class="panel support-identity" aria-labelledby="operator-heading">
        <div>
          <p class="tag">Signed-in account</p>
          <h2 id="operator-heading">{{ actor.fullName || actor.email }}</h2>
          <p>{{ actor.email }}</p>
        </div>
        <span class="support-badge">{{ operator ? 'Operator' : 'Standard account' }}</span>
      </section>
      @if(mode.isMasquerading)
        <section
          class="panel support-mode"
          aria-labelledby="mode-heading"
          data-support-mode
          data-context-token="{{ mode.contextToken }}"
          data-expires-at="{{ mode.expiresAt }}"
        >
          <div class="support-mode__header">
            <div>
              <p class="tag" data-mode-label>Support mode recorded</p>
              <h2 id="mode-heading">Customer: {{ target?.fullName || 'Unavailable account' }}</h2>
              <p class="support-copy">
                The stored mode belongs to
                {{ actor.fullName || actor.email }}
                across this account’s sessions. Customer access is checked again when a business page opens.
              </p>
            </div>
            <span class="support-badge" data-mode-badge>Recorded</span>
          </div>
          <p class="support-deadline">
            Access:
            {{ mode.access === 'edit' ? 'Can edit' : 'View only' }}. Fixed deadline:
            <time datetime="{{ mode.expiresAt }}">{{ expiresText }}</time>.
          </p>
          @if(!beforeDeadline)
            <p class="support-copy" role="status">
              The deadline has passed. Check status before choosing another customer.
            </p>
          @elseif(!targetAvailable)
            <p class="support-copy" role="status">
              This customer is unavailable. Use the stop control below to recover.
            </p>
          @elseif(!operator)
            <p class="support-copy" role="status">
              Operator access was removed. The stored mode can still be stopped here.
            </p>
          @else
            <p class="support-copy">
              This customer is present, but permission and eligibility are rechecked on the customer page.
            </p>
          @end

          <p
            class="support-copy"
            role="status"
            aria-live="polite"
            tabindex="-1"
            data-mode-notice
            hidden
          ></p>
          <div class="support-actions">
            @if(beforeDeadline && targetAvailable && operator)
              <a class="btn btn--secondary" href="/support/customer" data-support-intent>
                Review customer workspace
              </a>
            @end

            <a class="btn btn--secondary" href="/support">Check current status</a>
            @form({ route: 'demo.stop', method: 'POST' })
              <input type="hidden" name="_masqueradeContext" value="{{ mode.contextToken }}" />
              <button class="btn btn--primary" type="submit">Stop support mode</button>
            @end
          </div>
        </section>
      @elseif(!operator)
        <section class="panel" aria-labelledby="standard-heading">
          <h2 id="standard-heading">Operator access is required</h2>
          <p class="support-copy">
            This account cannot start support mode. Sign in with the seeded operator account to try this workspace. Ordinary signups remain standard accounts.
          </p>
        </section>
      @else
        <section class="panel" aria-labelledby="start-heading">
          <p class="tag">Support mode idle</p>
          <h2 id="start-heading">Choose a customer</h2>
          <p class="support-copy">
            Starting support mode changes the effective identity for all sessions of your operator account until you stop or the fixed deadline passes. The customer is not signed in.
          </p>
          @if(customers.length)
            @form({ route: 'demo.start', method: 'POST', class: 'support-form' })
              <input type="hidden" name="_masqueradeContext" value="{{ mode.contextToken }}" />
              <div class="field">
                <label class="field__label" for="targetId">Customer</label>
                <select
                  class="field__input"
                  id="targetId"
                  name="targetId"
                  required
                  aria-describedby="customer-hint"
                >
                  <option value="">Select a customer</option>
                  @each(customer in customers)
                    <option value="{{ customer.id }}">
                      {{ customer.fullName || customer.email }}
                      —
                      {{ customer.email }}
                    </option>
                  @end
                </select>
                <p class="field__hint" id="customer-hint">
                  Only active seeded customer accounts appear here.
                </p>
              </div>
              <div class="field">
                <label class="field__label" for="reason">Reason for access</label>
                <textarea
                  class="field__input support-reason"
                  id="reason"
                  name="reason"
                  required
                  minlength="1"
                  maxlength="500"
                  aria-describedby="reason-hint"
                ></textarea>
                <p class="field__hint" id="reason-hint">
                  Required for the audit record. Up to 500 characters; do not enter secrets.
                </p>
              </div>
              <fieldset class="field">
                <legend class="field__label">Access level</legend>
                <label class="field__choice">
                  <input type="radio" name="access" value="view" checked />
                  View only
                </label>
                <label class="field__choice">
                  <input type="radio" name="access" value="edit" />
                  Can edit
                </label>
              </fieldset>
              <button class="btn btn--primary" type="submit">Start support mode</button>
            @end
          @else
            <p role="status" class="support-copy">
              No eligible seeded customers are available. Run the local demo seed command, then refresh this page.
            </p>
          @end
        </section>
      @end
      @if(operator)
        <p class="support-footnote">
          This page checks the raw operator account and current mode. If a customer becomes unavailable, return here to inspect status and stop.
        </p>
      @end
    </div>
  @end
@end
