+@layouts.app({ title: 'Support workspace' })
+  @page()
+    <h1>Support workspace</h1>
+    <p>Signed in as {{ actor.email }}. The raw operator session remains the actor.</p>
+    @if(mode.isMasquerading)
+      <p role="status">Support mode active for {{ mode.targetId }}.</p>
+      @form({ route: 'fresh_edge.stop', method: 'POST' })
+        <input type="hidden" name="_masqueradeContext" value="{{ mode.contextToken }}" />
+        <button type="submit">Stop support mode</button>
+      @end
+    @elseif(actor.masqueradeOperator)
+      @form({ route: 'fresh_edge.start', method: 'POST' })
+        <input type="hidden" name="_masqueradeContext" value="{{ mode.contextToken }}" />
+        <label for="targetId">Customer</label>
+        <select id="targetId" name="targetId" required>
+          @each(customer in customers)
+            <option value="{{ customer.id }}">{{ customer.fullName }} — {{ customer.email }}</option>
+          @end
+        </select>
+        <label for="reason">Reason</label>
+        <textarea id="reason" name="reason" required maxlength="500">Checking a reported preference issue</textarea>
+        <button type="submit">Start support mode</button>
+      @end
+    @else
+      <p>No support controls are available for this account.</p>
+    @end
+  @end
+@end
