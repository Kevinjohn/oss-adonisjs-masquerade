+import User from '#models/user'
+import { demoStartInput, demoStopInput } from '#services/fresh_edge_control_input'
+import type { HttpContext } from '@adonisjs/core/http'
+import db from '@adonisjs/lucid/services/db'
+import { MasqueradeController, shareMasquerade } from 'adonisjs-masquerade/http'
+
+export default class FreshEdgeController extends MasqueradeController {
+  override async status(ctx: HttpContext) {
+    const actor = ctx.auth.use('web').getUserOrFail() as User
+    const runtime = await ctx.containerResolver.make('masquerade.runtime')
+    const mode = await runtime.service.status(ctx)
+    const customers = actor.masqueradeOperator
+      ? await User.query().whereNot('id', actor.id).where('active', true)
+      : []
+    ctx.response.send(await ctx.view.render('pages/support', { actor, mode, customers }))
+  }
+
+  override async start(ctx: HttpContext) {
+    const runtime = await ctx.containerResolver.make('masquerade.runtime')
+    await runtime.service.start(ctx, demoStartInput(ctx))
+    return ctx.response.redirect().toPath('/support/customer')
+  }
+
+  override async stop(ctx: HttpContext) {
+    const runtime = await ctx.containerResolver.make('masquerade.runtime')
+    await runtime.service.stop(ctx, demoStopInput(ctx))
+    return ctx.response.redirect().toPath('/support')
+  }
+
+  async customer(ctx: HttpContext) {
+    const mode = await shareMasquerade(ctx)
+    const customer = ctx.auth.user as User
+    const actor = ctx.auth.use('web').getUserOrFail() as User
+    const preference = await db.from('fresh_edge_preferences').where('user_id', customer.id).first()
+    ctx.response.send(await ctx.view.render('pages/customer', {
+      actor, customer, mode, emailUpdates: Boolean(preference?.email_updates),
+    }))
+  }
+
+  async preference(ctx: HttpContext) {
+    const customer = ctx.auth.user as User
+    if (!customer.active || !customer.canMutate) return ctx.response.forbidden('Preference updates are not permitted.')
+    const value = ctx.request.input('emailUpdates')
+    if (value !== '0' && value !== '1') return ctx.response.badRequest('Choose on or off.')
+    await db.table('fresh_edge_preferences').insert({ user_id: customer.id, email_updates: value === '1' }).onConflict('user_id').merge()
+    return ctx.response.redirect().toPath('/support/customer')
+  }
+
+  async sensitive(ctx: HttpContext) {
+    return ctx.response.forbidden('Sensitive actions are disabled during support mode.')
+  }
+}
